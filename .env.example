# ==========================================
# ResuLyzer Global Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="ResuLyzer – AI-Powered Resume Analyzer & ATS Platform"
API_V1_STR=/api/v1

# Security
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite development: sqlite:///./resumeiq.db
# Production PostgreSQL: postgresql://username:password@localhost:5432/resulyzer_db
DATABASE_URL=sqlite:///./resumeiq.db
POSTGRES_USER=resulyzer_user
POSTGRES_PASSWORD=resulyzer_secure_password
POSTGRES_DB=resulyzer_db

# Redis Caching (optional in dev, recommended in prod)
REDIS_URL=redis://localhost:6379/0

# Storage Paths
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
REPORT_DIR=storage/reports

# NLP Settings
ENABLE_TRANSFORMERS=True
TRANSFORMER_MODEL_NAME=all-MiniLM-L6-v2

# ATS Scoring Weights (Must sum to 1.0)
WEIGHT_REQUIRED_SKILLS=0.35
WEIGHT_SEMANTIC_SIMILARITY=0.25
WEIGHT_KEYWORD_RELEVANCE=0.15
WEIGHT_EXPERIENCE=0.10
WEIGHT_EDUCATION=0.10
WEIGHT_STRUCTURE=0.05

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

